# NetWatch Backend Configuration
# Copy to .env and fill in your values

# Application
NETWATCH_DEBUG=true
NETWATCH_ENV=development
NETWATCH_LOG_LEVEL=DEBUG

# CORS
NETWATCH_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/database
NETWATCH_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/netwatch
NETWATCH_DB_POOL_SIZE=5
NETWATCH_DB_MAX_OVERFLOW=10

# AWS (optional - for cloud integration)
# NETWATCH_AWS_REGION=us-east-1
# NETWATCH_AWS_ACCESS_KEY_ID=
# NETWATCH_AWS_SECRET_ACCESS_KEY=
# NETWATCH_VPC_FLOW_LOG_BUCKET=

# Detection thresholds
NETWATCH_PORT_SCAN_THRESHOLD=20
NETWATCH_BRUTE_FORCE_THRESHOLD=10
NETWATCH_DATA_EXFIL_THRESHOLD=10000000
NETWATCH_DETECTION_TIME_WINDOW=3600

# Ingestion limits
NETWATCH_MAX_FILE_SIZE=524288000
NETWATCH_MAX_RECORDS=50000
NETWATCH_CHUNK_SIZE=1048576